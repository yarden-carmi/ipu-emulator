    name = "test_cell_nms_composition",
    srcs = ["test/test_cell_nms_composition.py"],
    data = [
        "src/ipu_apps/convolutions_universal/conv/conv1x1/conv1x1.asm",
        "src/ipu_apps/detect/channel_peak/channel_peak.asm",
        "src/ipu_apps/softmax/softmax_columns/softmax_columns.asm",
        "src/ipu_apps/softmax/softmax_columns_packed/softmax_columns_packed.asm",
    ],
    imports = ["src"],
    deps = [
        ":ipu_apps_lib",
        requirement("pytest"),
    ],
)

# Router only -- no .asm needed; it constructs apps but never runs them.
py_pytest_test(
    name = "test_softmax_registry",
    srcs = ["test/test_softmax_registry.py"],
    imports = ["src"],
    deps = [
        ":ipu_apps_lib",
        requirement("pytest"),
    ],
)

# Kernel registry mechanics + the generic conformance suite, which assembles
# and runs whichever kernel the registry resolves -- so every registered .asm
# is data here, and a newly added kernel is covered without editing this rule.
py_pytest_test(
    name = "test_kernel_registry",
    srcs = ["test/test_kernel_registry.py"],
    data = glob(["src/ipu_apps/**/*.asm"]),
    imports = ["src"],
    deps = [
        ":ipu_apps_lib",
        requirement("pytest"),
    ],
)

# Checks the routing tables printed in the docs against what the registry
# actually answers. The tables are checked-in text, so without this they are a
# second copy of the routing rules -- the copy that goes stale.
py_pytest_test(
    name = "test_docs_routing",
    srcs = ["test/test_docs_routing.py"],
    data = ["//docs:doc_sources"],
    imports = ["src"],
    deps = [
        ":ipu_apps_lib",
        requirement("pytest"),
    ],
)
